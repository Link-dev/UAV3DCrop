@@ -0,0 +1,32 @@
+# UAV3DCrop, CityGaussian stage 2: partition the coarse model into blocks and fine-tune each
+# block from it (30k steps), then merge. utils/partition_citygs.py reads block_dim and
+# content_threshold below and assigns every training image to the blocks it covers.
+# COARSE_CKPT is replaced by the stage-1 checkpoint path (see RUN.md).
+logger: tensorboard
+model:
+  initialize_from: COARSE_CKPT
+  overwrite_config: false
+  gaussian:
+    init_args:
+      optimization:
+        means_lr_init: 0.000064
+        means_lr_scheduler:
+          lr_final: 0.00000064
+        scales_lr: 0.004
+trainer:
+  max_steps: 30000
+data:
+  image_uint8: true
+  parser:
+    class_path: ColmapBlock
+    init_args:
+      image_dir: images_undistort
+      down_sample_factor: 1
+      split_mode: experiment
+      eval_image_select_mode: list
+      eval_list: split.json
+      points_from: sfm
+      content_threshold: 0.05
+      block_dim:
+      - 2
+      - 2
