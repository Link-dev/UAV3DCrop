diff --git a/qc_callback.py b/qc_callback.py
new file mode 100644
index 0000000..7487e0d
--- /dev/null
+++ b/qc_callback.py
@@ -0,0 +1,95 @@
+"""Large-Gaussian QC filter for CityGaussian, injected as a Lightning callback.
+
+Does NOT modify any original file. Enable by appending on the CLI:
+    --trainer.callbacks+=qc_callback.QCFilterCallback
+and setting env:
+    QC_MODE=aabb|size|both  QC_SCENE=<scene>  [QC_AABB_MULT QC_MAX_SCALE_M QC_PCT_LO QC_PCT_HI QC_METRIC_SCALE]
+When QC_MODE is unset/none the callback is a strict no-op (original behaviour preserved).
+
+On test/validation start it prunes the loaded in-memory Gaussians (means/scales/opacities/...):
+    keep = (center inside 1.25x percentile-AABB) AND (max physical axis * metric_scale <= 2 m)
+The checkpoint is never written. Pair with SAVE_VAL_DEPTH_DIR=<...>_S{n} to keep S0 depth intact.
+"""
+import os
+import json
+import numpy as np
+import torch
+from lightning.pytorch.callbacks import Callback
+
+BENCH = os.environ.get("UAV3DCROP_ROOT")   # dataset root: <root>/<scene>/transform_undistort.json
+
+
+def _metric_scale(scene):
+    if not BENCH:
+        raise RuntimeError("Set UAV3DCROP_ROOT to the dataset root (the folder that contains <scene>/transform_undistort.json).")
+    scale = json.load(open(f"{BENCH}/{scene}/transform_undistort.json"))["scale"]
+    return scale
+
+
+class QCFilterCallback(Callback):
+    def __init__(self):
+        super().__init__()
+        self._done = False
+
+    def _apply(self, pl_module):
+        mode = os.environ.get("QC_MODE", "none")
+        if mode == "none" or self._done:
+            return
+        self._done = True
+        gm = pl_module.gaussian_model
+        scene = os.environ["QC_SCENE"]
+        mult = float(os.environ.get("QC_AABB_MULT", "1.25"))
+        max_scale_m = float(os.environ.get("QC_MAX_SCALE_M", "2.0"))
+        plo = float(os.environ.get("QC_PCT_LO", "0.5"))
+        phi = float(os.environ.get("QC_PCT_HI", "99.5"))
+        metric_scale = float(os.environ.get("QC_METRIC_SCALE", _metric_scale(scene)))
+
+        with torch.no_grad():
+            means = gm.get_xyz.detach()
+            N = means.shape[0]
+            mnp = means.cpu().numpy()
+            amin = torch.tensor(np.percentile(mnp, plo, axis=0), device=means.device, dtype=means.dtype)
+            amax = torch.tensor(np.percentile(mnp, phi, axis=0), device=means.device, dtype=means.dtype)
+            center = (amin + amax) / 2
+            half = (amax - amin) / 2
+            inside = torch.all(torch.abs(means - center) <= half * mult, dim=-1)
+            within = (gm.get_scaling.detach().max(dim=-1).values * metric_scale) <= max_scale_m
+            if mode == "aabb":
+                keep = inside
+            elif mode == "size":
+                keep = within
+            elif mode == "both":
+                keep = inside & within
+            else:
+                raise ValueError(mode)
+            excluded = int((~keep).sum())
+
+            # prune every per-Gaussian tensor in place (gm.gaussians is an nn.ParameterDict;
+            # reassign each key rather than replacing the registered submodule)
+            for k in list(gm.gaussians.keys()):
+                v = gm.gaussians[k]
+                if torch.is_tensor(v) and v.shape[0] == N:
+                    gm.gaussians[k] = torch.nn.Parameter(v[keep].detach(), requires_grad=False)
+
+        info = {"qc_mode": mode, "aabb_source": f"gauss_percentile_{plo}_{phi}",
+                "aabb_multiplier": mult, "max_gaussian_scale_m": max_scale_m,
+                "metric_scale_m_per_colmap_unit": metric_scale, "scene": scene,
+                "gaussian_count": int(N), "kept_gaussian_count": int(keep.sum()),
+                "excluded_gaussian_count": excluded,
+                "excluded_fraction": excluded / N if N else 0.0,
+                "outside_expanded_aabb_count": int((~inside).sum()),
+                "oversized_gaussian_count": int((~within).sum()), "checkpoint_modified": False}
+        dd = os.environ.get("SAVE_VAL_DEPTH_DIR")
+        if dd:
+            os.makedirs(dd, exist_ok=True)
+            json.dump(info, open(os.path.join(dd, "qc_meta.json"), "w"), indent=2)
+        print(f"[QC {mode}] {scene} metric_scale={metric_scale:.6g} kept {info['kept_gaussian_count']:,}/{N:,} "
+              f"excluded {excluded:,} ({info['excluded_fraction']*100:.2f}%) "
+              f"[outside={info['outside_expanded_aabb_count']:,} oversized={info['oversized_gaussian_count']:,}]",
+              flush=True)
+
+    def on_test_start(self, trainer, pl_module):
+        self._apply(pl_module)
+
+    def on_validation_start(self, trainer, pl_module):
+        self._apply(pl_module)
