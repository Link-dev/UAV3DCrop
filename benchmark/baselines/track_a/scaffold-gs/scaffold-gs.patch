@@ -0,0 +1,138 @@
+#
+# Standalone QC-filtered depth exporter for Scaffold-GS. Does NOT modify render.py.
+# Scaffold decodes neural Gaussians per view (generate_neural_gaussians), so the
+# large-Gaussian filter (S-series) is applied to the DECODED Gaussians each view:
+#   keep = (decoded center inside 1.25x percentile-AABB) AND (max decoded axis*metric <= 2m)
+# excluded Gaussians are made transparent (opacity=0) for that view's depth render only.
+# AABB box is computed once from the anchor positions (stable scene extent).
+#
+#   --qc_mode none|aabb|size|both   (default none == identical depth to render.py)
+# Output -> test/ours_<it>/depth_S{n}  (S0 = existing 'depth', untouched).
+#
+import torch, os, json, math
+import numpy as np
+from tqdm import tqdm
+from os import makedirs
+from diff_gaussian_rasterization import GaussianRasterizationSettings, GaussianRasterizer
+from scene import Scene
+from gaussian_renderer import prefilter_voxel, generate_neural_gaussians, GaussianModel
+from utils.general_utils import safe_state
+from argparse import ArgumentParser
+from arguments import ModelParams, PipelineParams, get_combined_args
+
+BENCH = os.environ.get("UAV3DCROP_ROOT")   # dataset root: <root>/<scene>/transform_undistort.json
+
+
+def scene_metric_scale(model_path):
+    if not BENCH:
+        raise RuntimeError("Set UAV3DCROP_ROOT to the dataset root (the folder that contains <scene>/transform_undistort.json).")
+    scene = os.path.basename(os.path.dirname(model_path))
+    scale = json.load(open(f"{BENCH}/{scene}/transform_undistort.json"))["scale"]
+    return scale, scene
+
+
+def keep_mask(xyz, scaling, box_c, box_half, mult, max_scale_m, metric_scale, mode):
+    inside = torch.all(torch.abs(xyz - box_c) <= box_half * mult, dim=-1)
+    within = (scaling.max(dim=-1).values * metric_scale) <= max_scale_m
+    if mode == "aabb":
+        return inside, inside, within
+    if mode == "size":
+        return within, inside, within
+    if mode == "both":
+        return inside & within, inside, within
+    return torch.ones_like(inside), inside, within
+
+
+def render_depth_qc_view(view, pc, pipe, visible_mask, box_c, box_half, mult, max_scale_m, metric_scale, mode, counter):
+    xyz, color, opacity, scaling, rot = generate_neural_gaussians(view, pc, visible_mask, is_training=False)
+    keep, inside, within = keep_mask(xyz, scaling, box_c, box_half, mult, max_scale_m, metric_scale, mode)
+    excl = ~keep
+    opacity = opacity.clone()
+    opacity[excl] = 0.0                                          # transparent for this depth render only
+    counter["total"] += int(keep.numel()); counter["excluded"] += int(excl.sum())
+    counter["outside"] += int((~inside).sum()); counter["oversized"] += int((~within).sum())
+
+    W = view.world_view_transform
+    z = (xyz @ W[:3, :3] + W[3, :3])[:, 2:3]
+    z3 = z.repeat(1, 3)
+    ones = torch.ones_like(z3)
+    raster_settings = GaussianRasterizationSettings(
+        image_height=int(view.image_height), image_width=int(view.image_width),
+        tanfovx=math.tan(view.FoVx * 0.5), tanfovy=math.tan(view.FoVy * 0.5),
+        bg=torch.zeros(3, dtype=torch.float32, device="cuda"), scale_modifier=1.0,
+        viewmatrix=view.world_view_transform, projmatrix=view.full_proj_transform,
+        sh_degree=1, campos=view.camera_center, prefiltered=False, debug=pipe.debug)
+    rasterizer = GaussianRasterizer(raster_settings=raster_settings)
+    sp = torch.zeros_like(xyz, device="cuda")
+    kw = dict(means3D=xyz, means2D=sp, shs=None, opacities=opacity, scales=scaling, rotations=rot, cov3D_precomp=None)
+    depth_sum, _ = rasterizer(colors_precomp=z3, **kw)
+    acc, _ = rasterizer(colors_precomp=ones, **kw)
+    depth = depth_sum[0:1] / (acc[0:1] + 1e-8)
+    depth[acc[0:1] < 1e-4] = 0.0
+    return depth
+
+
+def run(dataset, iteration, pipeline, mode, mult, max_scale_m, tag, metric_override, plo, phi):
+    with torch.no_grad():
+        gaussians = GaussianModel(dataset.feat_dim, dataset.n_offsets, dataset.voxel_size,
+                                  dataset.update_depth, dataset.update_init_factor, dataset.update_hierachy_factor,
+                                  dataset.use_feat_bank, dataset.appearance_dim, dataset.ratio,
+                                  dataset.add_opacity_dist, dataset.add_cov_dist, dataset.add_color_dist)
+        scene = Scene(dataset, gaussians, load_iteration=iteration, shuffle=False)
+        gaussians.eval()
+        bg = torch.tensor([1, 1, 1] if dataset.white_background else [0, 0, 0], dtype=torch.float32, device="cuda")
+
+        metric_scale, scene_name = scene_metric_scale(dataset.model_path)
+        if metric_override is not None:
+            metric_scale = metric_override
+        anchors = gaussians.get_anchor.detach().cpu().numpy()
+        amin = torch.tensor(np.percentile(anchors, plo, axis=0), device="cuda", dtype=torch.float32)
+        amax = torch.tensor(np.percentile(anchors, phi, axis=0), device="cuda", dtype=torch.float32)
+        box_c = (amin + amax) / 2
+        box_half = (amax - amin) / 2
+
+        out = os.path.join(dataset.model_path, "test", f"ours_{scene.loaded_iter}", f"depth_{tag}")
+        makedirs(out, exist_ok=True)
+        counter = {"total": 0, "excluded": 0, "outside": 0, "oversized": 0}
+        for view in tqdm(scene.getTestCameras(), desc=f"ScafDepth[{tag}]"):
+            vmask = prefilter_voxel(view, gaussians, pipeline, bg)
+            d = render_depth_qc_view(view, gaussians, pipeline, vmask, box_c, box_half,
+                                     mult, max_scale_m, metric_scale, mode, counter)
+            np.save(os.path.join(out, view.image_name + ".npy"), d.squeeze(0).cpu().numpy())
+        # counters are summed over views (neural gaussians regenerate per view); report per-view average
+        nviews = len(scene.getTestCameras())
+        info = {"qc_mode": mode, "aabb_source": f"anchor_percentile_{plo}_{phi}",
+                "aabb_multiplier": mult, "max_gaussian_scale_m": max_scale_m,
+                "metric_scale_m_per_colmap_unit": metric_scale, "scene": scene_name, "n_views": nviews,
+                "avg_neural_gaussians_per_view": counter["total"] / max(nviews, 1),
+                "avg_excluded_per_view": counter["excluded"] / max(nviews, 1),
+                "avg_excluded_fraction": counter["excluded"] / max(counter["total"], 1),
+                "avg_outside_per_view": counter["outside"] / max(nviews, 1),
+                "avg_oversized_per_view": counter["oversized"] / max(nviews, 1)}
+        json.dump(info, open(os.path.join(out, "qc_meta.json"), "w"), indent=2)
+        print(f"[QC {mode}] {scene_name} metric_scale={metric_scale:.6g} "
+              f"avg excluded {info['avg_excluded_per_view']:.0f}/{info['avg_neural_gaussians_per_view']:.0f} "
+              f"({info['avg_excluded_fraction']*100:.2f}%) -> {out}")
+
+
+if __name__ == "__main__":
+    parser = ArgumentParser(description="QC depth exporter (Scaffold-GS)")
+    model = ModelParams(parser, sentinel=True)
+    pipeline = PipelineParams(parser)
+    parser.add_argument("--iteration", default=-1, type=int)
+    parser.add_argument("--qc_mode", choices=("none", "aabb", "size", "both"), default="none")
+    parser.add_argument("--aabb_multiplier", type=float, default=1.25)
+    parser.add_argument("--max_gaussian_scale_m", type=float, default=2.0)
+    parser.add_argument("--aabb_pct_lo", type=float, default=0.5)
+    parser.add_argument("--aabb_pct_hi", type=float, default=99.5)
+    parser.add_argument("--out_tag", default=None)
+    parser.add_argument("--metric_scale", type=float, default=None)
+    parser.add_argument("--quiet", action="store_true")
+    args = get_combined_args(parser)
+    safe_state(getattr(args, "quiet", False))
+    out_tag = getattr(args, "out_tag", None)
+    metric_override = getattr(args, "metric_scale", None)
+    tag = out_tag or {"none": "S0", "aabb": "S1", "size": "S2", "both": "S3"}[args.qc_mode]
+    run(model.extract(args), args.iteration, pipeline.extract(args), args.qc_mode,
+        args.aabb_multiplier, args.max_gaussian_scale_m, tag, metric_override,
+        args.aabb_pct_lo, args.aabb_pct_hi)
