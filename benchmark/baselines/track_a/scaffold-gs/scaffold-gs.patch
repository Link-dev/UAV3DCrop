+def lpips_tiled(lpips_fn, img0, img1, max_pixels=5000000):
+    # full-res LPIPS via fp32 row-tiles (avoids 40GB OOM + fp16 NaN); area-weighted mean.
+    _, _, H, W = img0.shape
+    n = max(1, (H * W + max_pixels - 1) // max_pixels)
+    bounds = [(i * H) // n for i in range(n + 1)]
+    acc, total = 0.0, 0
+    for i in range(n):
+        h0, h1 = bounds[i], bounds[i + 1]
+        if h1 <= h0:
+            continue
+        with torch.no_grad():
+            d = lpips_fn(img0[:, :, h0:h1, :], img1[:, :, h0:h1, :]).item()
+        area = (h1 - h0) * W
+        acc += d * area
+        total += area
+        torch.cuda.empty_cache()
+    return torch.tensor(acc / total)
+
