+def render_depth(viewpoint_camera, pc : GaussianModel, pipe, visible_mask=None, scaling_modifier=1.0):
+    """Alpha-weighted expected depth in the sparse/0 (COLMAP) frame for Scaffold-GS.
+
+    Runs the neural-gaussian MLP once, then rasterizes camera-space z (as color) and
+    all-ones (for accumulated opacity) and normalizes. Same geometry/opacity as the RGB render.
+    Units follow sparse/0 (meters).
+    """
+    xyz, color, opacity, scaling, rot = generate_neural_gaussians(
+        viewpoint_camera, pc, visible_mask, is_training=False)
+
+    W = viewpoint_camera.world_view_transform
+    z = (xyz @ W[:3, :3] + W[3, :3])[:, 2:3]
+    z3 = z.repeat(1, 3)
+    ones = torch.ones_like(z3)
+
+    tanfovx = math.tan(viewpoint_camera.FoVx * 0.5)
+    tanfovy = math.tan(viewpoint_camera.FoVy * 0.5)
+    raster_settings = GaussianRasterizationSettings(
+        image_height=int(viewpoint_camera.image_height),
+        image_width=int(viewpoint_camera.image_width),
+        tanfovx=tanfovx, tanfovy=tanfovy,
+        bg=torch.zeros(3, dtype=torch.float32, device="cuda"),   # black bg
+        scale_modifier=scaling_modifier,
+        viewmatrix=viewpoint_camera.world_view_transform,
+        projmatrix=viewpoint_camera.full_proj_transform,
+        sh_degree=1, campos=viewpoint_camera.camera_center,
+        prefiltered=False, debug=pipe.debug)
+    rasterizer = GaussianRasterizer(raster_settings=raster_settings)
+    sp = torch.zeros_like(xyz, device="cuda")
+    kw = dict(means3D=xyz, means2D=sp, shs=None, opacities=opacity,
+              scales=scaling, rotations=rot, cov3D_precomp=None)
+    depth_sum, _ = rasterizer(colors_precomp=z3, **kw)
+    acc, _ = rasterizer(colors_precomp=ones, **kw)
+    depth = depth_sum[0:1] / (acc[0:1] + 1e-8)
+    depth[acc[0:1] < 1e-4] = 0.0
+    return depth
+
+
