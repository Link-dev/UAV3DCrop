+def render_depth(viewpoint_camera, pc : GaussianModel, pipe, kernel_size):
+    """Alpha-weighted expected depth in the sparse/0 (COLMAP) coordinate frame.
+
+    Trick: composite per-gaussian camera-space z as color, then normalize by the
+    accumulated opacity (rendered with all-ones color). Uses the SAME geometry/opacity
+    (3D-filter opacity & scaling) as the RGB render, so depth matches the image.
+    NOTE: units follow sparse/0 (meters).
+    """
+    black = torch.zeros(3, dtype=torch.float32, device="cuda")
+    W = viewpoint_camera.world_view_transform
+    z = (pc.get_xyz @ W[:3, :3] + W[3, :3])[:, 2:3]          # camera-space depth (N,1)
+    z3 = z.repeat(1, 3)
+    ones = torch.ones_like(z3)
+    depth_sum = render(viewpoint_camera, pc, pipe, black, kernel_size=kernel_size,
+                       override_color=z3)["render"][0:1]      # (1,H,W)
+    acc = render(viewpoint_camera, pc, pipe, black, kernel_size=kernel_size,
+                 override_color=ones)["render"][0:1]
+    depth = depth_sum / (acc + 1e-8)
+    depth[acc < 1e-4] = 0.0
+    return depth
