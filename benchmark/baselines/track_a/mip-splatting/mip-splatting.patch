index 0000000..37b36b1
--- /dev/null
+++ b/render_depth_qc.py
@@ -0,0 +1,127 @@
+#
+# Standalone QC-filtered depth exporter for mip-splatting.
+# Does NOT modify render.py. Adds the large-Gaussian render-time filter from
+# the revised export (large-Gaussian filter), behind an opt-in switch.
+#
+#   --qc_mode none|aabb|size|both   (default none == identical to render.py depth)
+#
+# S0 = existing test/ours_30000/depth_1  (produced by render.py, untouched)
+# S1 = --qc_mode aabb , S2 = --qc_mode size , S3 = --qc_mode both
+# Output goes to a SEPARATE dir  test/ours_30000/depth_{sf}_{tag}  so nothing is overwritten.
+#
+import torch
+import os, json, time
+import numpy as np
+from tqdm import tqdm
+from os import makedirs
+from scene import Scene
+from gaussian_renderer import render_depth, GaussianModel
+from utils.general_utils import safe_state
+from argparse import ArgumentParser
+from arguments import ModelParams, PipelineParams, get_combined_args
+
+BENCH = os.environ.get("UAV3DCROP_ROOT")   # dataset root: <root>/<scene>/transform_undistort.json
+
+
+def percentile_aabb(means_np, plo, phi):
+    """Robust scene box = per-axis [plo, phi] percentile of Gaussian centers (colmap frame)."""
+    return np.percentile(means_np, plo, axis=0), np.percentile(means_np, phi, axis=0)
+
+
+def scene_metric_scale(model_path):
+    """meters per colmap unit, from transform_undistort.json (1.0 for the released data)."""
+    if not BENCH:
+        raise RuntimeError("Set UAV3DCROP_ROOT to the dataset root (the folder that contains <scene>/transform_undistort.json).")
+    scene = os.path.basename(os.path.dirname(model_path))          # .../<scene>/<scene>_colmap
+    scale = json.load(open(f"{BENCH}/{scene}/transform_undistort.json"))["scale"]
+    return scale, scene
+
+
+def apply_qc_filter(gaussians, mult, max_scale_m, metric_scale, mode, plo, phi):
+    with torch.no_grad():
+        means = gaussians.get_xyz.detach()
+        dev, dt = means.device, means.dtype
+        aabb_min, aabb_max = percentile_aabb(means.cpu().numpy(), plo, phi)
+        amin = torch.tensor(aabb_min, device=dev, dtype=dt)
+        amax = torch.tensor(aabb_max, device=dev, dtype=dt)
+        center = (amin + amax) / 2
+        half = (amax - amin) / 2
+        inside = torch.all(torch.abs(means - center) <= half * mult, dim=-1)
+        max_scale_colmap = gaussians.get_scaling.detach().max(dim=-1).values
+        within = (max_scale_colmap * metric_scale) <= max_scale_m
+        if mode == "aabb":
+            keep = inside
+        elif mode == "size":
+            keep = within
+        elif mode == "both":
+            keep = inside & within
+        else:
+            keep = torch.ones_like(inside)
+        excluded = ~keep
+        gaussians._opacity[excluded] = -100.0                      # in-memory only; checkpoint untouched
+        total = int(keep.numel())
+        return {
+            "applied": mode != "none", "qc_mode": mode,
+            "aabb_source": f"gauss_percentile_{plo}_{phi}",
+            "aabb_multiplier": float(mult), "max_gaussian_scale_m": float(max_scale_m),
+            "metric_scale_m_per_colmap_unit": float(metric_scale),
+            "aabb_min": [float(x) for x in aabb_min], "aabb_max": [float(x) for x in aabb_max],
+            "gaussian_count": total, "kept_gaussian_count": int(keep.sum()),
+            "excluded_gaussian_count": total - int(keep.sum()),
+            "excluded_fraction": float((total - int(keep.sum())) / total) if total else 0.0,
+            "outside_expanded_aabb_count": int((~inside).sum()),
+            "oversized_gaussian_count": int((~within).sum()),
+            "checkpoint_modified": False,
+        }
+
+
+def render_depth_qc(dataset, iteration, pipeline, mode, mult, max_scale_m, tag, metric_override, plo, phi):
+    with torch.no_grad():
+        gaussians = GaussianModel(dataset.sh_degree)
+        scene = Scene(dataset, gaussians, load_iteration=iteration, shuffle=False)
+        sf = dataset.resolution
+        kernel_size = dataset.kernel_size
+        mpath = dataset.model_path
+
+        metric_scale, scene_name = scene_metric_scale(mpath)
+        if metric_override is not None:
+            metric_scale = metric_override
+
+        info = apply_qc_filter(gaussians, mult, max_scale_m, metric_scale, mode, plo, phi)
+        info.update({"scene": scene_name, "loaded_iter": scene.loaded_iter})
+        print(f"[QC {mode}] scene={scene_name} metric_scale={metric_scale:.6g} "
+              f"kept {info['kept_gaussian_count']:,}/{info['gaussian_count']:,} "
+              f"excluded {info['excluded_gaussian_count']:,} ({info['excluded_fraction']*100:.2f}%) "
+              f"[outside={info['outside_expanded_aabb_count']:,} oversized={info['oversized_gaussian_count']:,}]")
+
+        out = os.path.join(mpath, "test", f"ours_{scene.loaded_iter}", f"depth_{sf}_{tag}")
+        makedirs(out, exist_ok=True)
+        for view in tqdm(scene.getTestCameras(), desc=f"Depth[{tag}]"):
+            d = render_depth(view, gaussians, pipeline, kernel_size)
+            np.save(os.path.join(out, view.image_name + ".npy"), d.squeeze(0).cpu().numpy())
+        json.dump(info, open(os.path.join(out, "qc_meta.json"), "w"), indent=2)
+        print(f"[QC {mode}] wrote depth -> {out}")
+
+
+if __name__ == "__main__":
+    parser = ArgumentParser(description="QC-filtered depth exporter (mip-splatting)")
+    model = ModelParams(parser, sentinel=True)
+    pipeline = PipelineParams(parser)
+    parser.add_argument("--iteration", default=-1, type=int)
+    parser.add_argument("--qc_mode", choices=("none", "aabb", "size", "both"), default="none")
+    parser.add_argument("--aabb_multiplier", type=float, default=1.25)
+    parser.add_argument("--max_gaussian_scale_m", type=float, default=2.0)
+    parser.add_argument("--aabb_pct_lo", type=float, default=0.5)
+    parser.add_argument("--aabb_pct_hi", type=float, default=99.5)
+    parser.add_argument("--out_tag", default=None, help="output dir suffix; default S0/S1/S2/S3 by mode")
+    parser.add_argument("--metric_scale", type=float, default=None, help="override m-per-colmap-unit")
+    parser.add_argument("--quiet", action="store_true")
+    args = get_combined_args(parser)
+    safe_state(getattr(args, "quiet", False))
+    # get_combined_args drops args whose value is None -> read those defensively
+    out_tag = getattr(args, "out_tag", None)
+    metric_override = getattr(args, "metric_scale", None)
+    tag = out_tag or {"none": "S0", "aabb": "S1", "size": "S2", "both": "S3"}[args.qc_mode]
+    render_depth_qc(model.extract(args), args.iteration, pipeline.extract(args),
+                    args.qc_mode, args.aabb_multiplier, args.max_gaussian_scale_m, tag,
+                    metric_override, args.aabb_pct_lo, args.aabb_pct_hi)
