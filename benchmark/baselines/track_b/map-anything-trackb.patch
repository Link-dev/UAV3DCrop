@@ -0,0 +1,79 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+#
+# This source code is licensed under the Apache License, Version 2.0
+# found in the LICENSE file in the root directory of this source tree.
+
+"""
+Benchmark WAI datasets (WAI_Dataset_benchmark) for the zero-shot feed-forward track.
+
+Covers the eight benchmark sequences:
+    umn2023_corn, umn2023_soy,
+    umn2024_corn1, umn2024_corn2,
+    umn2025_wheat, umn2025_oat, umn2025_corn, umn2025_soybean
+
+All of them use the same WAI layout (``images/ depth/ scene_meta.json`` per scene)
+and are read by ``BaseCornDataset``. Scene lists are read from
+``<mapanything_dataset_metadata_dir>/<split>/<key>_scene_list_<split>.npy``; the data root
+and the metadata dir are set by the machine config (``machine=uav3dcrop``).
+
+A small factory creates one subclass per sequence so that each has a distinct class
+name: the benchmark script uses the class name as a dict key, so identical names would
+collide and drop all but one dataset.
+"""
+
+import os
+import numpy as np
+from mapanything.datasets.base.base_corn_dataset import BaseCornDataset
+
+
+class _BenchmarkWAIBase(BaseCornDataset):
+    """Base class; subclasses override ``dataset_key`` to pick the split npy."""
+
+    dataset_key: str = ""
+
+    def _load_data(self):
+        split_metadata_path = os.path.join(
+            self.dataset_metadata_dir,
+            self.split,
+            f"{self.dataset_key}_scene_list_{self.split}.npy",
+        )
+        split_scene_list = np.load(split_metadata_path, allow_pickle=True)
+        if not self.sample_specific_scene:
+            self.scenes = list(split_scene_list)
+        else:
+            self.scenes = [self.specific_scene_name]
+        self.num_of_scenes = len(self.scenes)
+        self.dataset_name = self.dataset_key.upper()
+
+
+BENCHMARK_DATASET_KEYS = [
+    "umn2023_corn", "umn2023_soy",
+    "umn2024_corn1", "umn2024_corn2",
+    "umn2025_wheat", "umn2025_oat", "umn2025_corn", "umn2025_soybean",
+]
+
+
+def _class_name(key: str) -> str:
+    """umn2024_corn1 -> UMN2024Corn1WAIBenchmark; umn2025_corn -> UMN2025CornWAIBenchmark."""
+    parts = key.split("_")
+    pieces = []
+    for p in parts:
+        if not p:
+            continue
+        # keep all-uppercase tokens as-is; capitalize first letter of lowercase ones
+        pieces.append(p if p.isupper() or any(c.isdigit() for c in p) and p[0].isupper()
+                      else p[0].upper() + p[1:])
+    # umn2024 -> Umn2024; force UMN prefix uppercase
+    first = pieces[0]
+    if first.lower().startswith("umn"):
+        pieces[0] = "UMN" + first[3:]
+    return "".join(pieces) + "WAIBenchmark"
+
+
+# Dynamically create one subclass per dataset and expose at module level
+__all__ = []
+for _key in BENCHMARK_DATASET_KEYS:
+    _name = _class_name(_key)
+    _cls = type(_name, (_BenchmarkWAIBase,), {"dataset_key": _key})
+    globals()[_name] = _cls
+    __all__.append(_name)
